# Everbright website — Apache / cPanel / Hostinger routing.
# Sends every page address (e.g. /police-store, /products/...) to index.html,
# so refreshing a page or opening a shared link never shows "page not found".
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Serve modern image and font types correctly
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType font/woff .woff
</IfModule>
